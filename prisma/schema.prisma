generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum PurchaseBillStatus {
  RECEIVED
  DRAFT
  PARTIAL
}

enum PurchaseCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SaleStatus {
  PAID
  PENDING
  VOIDED
}

enum DiscountType {
  PERCENT
  THB
}

enum PharmAccountRole {
  OWNER
  PHARMACIST
}

enum ProductCompositionStatus {
  PENDING
  VERIFIED
  UNAVAILABLE
  NOT_APPLICABLE
}

model PharmAccount {
  id                      String                  @id
  username                String                  @unique
  passwordHash            String?
  name                    String
  phone                   String                  @default("")
  pharmacistLicenseNumber String?
  avatarUrl               String?
  role                    PharmAccountRole
  isActive                Boolean                 @default(true)
  mustChangePassword      Boolean                 @default(false)
  setupCompletedAt        DateTime?
  lastLoginAt             DateTime?
  createdById             String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  createdBy               PharmAccount?           @relation("PharmAccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAccounts         PharmAccount[]          @relation("PharmAccountCreator")
  preferences             PharmAccountPreference?
  sessions                AuthSession[]

  @@index([role, isActive])
}

model PharmAccountPreference {
  accountId            String       @id
  locale               String       @default("en")
  colorTheme           String       @default("pharmacy-green")
  memberDefaultSort    String       @default("lastOrderAt")
  showArchivedMembers  Boolean      @default(false)
  analysisDefaultRange String       @default("30d")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  account              PharmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AuthSession {
  tokenHash String       @id
  accountId String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  account   PharmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model AuthLoginThrottle {
  keyHash         String   @id
  attempts        Int
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String    @unique
  country   String?
  website   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                   String                    @id
  externalProductCode  String?                   @unique
  barcode              String                    @unique
  itemName             String
  brandName            String
  manufacturerId       String
  categoryId           String
  packUnit             String
  childUnit            String
  childQuantity        Decimal                   @db.Decimal(14, 3)
  packLabel            String
  location             String
  minimumStock         Int                       @default(20)
  maximumStock         Int                       @default(200)
  discountPercent      Int                       @default(0)
  migrationGenericName String?
  legalCategory        String?
  migrationCostThb     Decimal?                  @db.Decimal(16, 4)
  isDiscountLocked     Boolean                   @default(false)
  isReturnable         Boolean                   @default(true)
  defaultDoseMorning   Int                       @default(0)
  defaultDoseNoon      Int                       @default(0)
  defaultDoseEvening   Int                       @default(0)
  defaultDoseNight     Int                       @default(0)
  tagName              String                    @default("")
  imageUrl             String
  weeklySold           Int                       @default(0)
  isActive             Boolean                   @default(true)
  compositionStatus    ProductCompositionStatus  @default(PENDING)
  compositionCheckedAt DateTime?
  compositionRetryAt   DateTime?
  compositionError     String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  manufacturer         Manufacturer              @relation(fields: [manufacturerId], references: [id])
  category             Category                  @relation(fields: [categoryId], references: [id])
  parentPacks          ProductParentPack[]
  barcodeAliases       ProductBarcodeAlias[]
  batches              ProductBatch[]
  favoriteCustomers    CustomerFavoriteProduct[]
  purchaseLines        PurchaseLine[]
  saleLines            SaleLine[]
  importedPurchaseHistory CustomerPurchaseHistoryImport[]
  stockAdjustmentLines StockAdjustmentLine[]
  activeIngredients    ProductIngredient[]
  imageAsset           ProductImageAsset?

  @@index([categoryId])
  @@index([manufacturerId])
  @@index([itemName])
  @@index([isActive, itemName, id])
  @@index([isActive, weeklySold, itemName, id])
}

model ProductDataImportRun {
  id                String   @id
  sourceSoftware    String
  mode              String
  sourceFileName    String
  sourceFileHash    String
  importedBy        String
  changedCount      Int
  unchangedCount    Int
  unmatchedCount    Int
  invalidCount      Int
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

model Ingredient {
  id                String                      @id
  canonicalName     String                      @unique
  normalizedName    String                      @unique
  thaiName          String?
  aliases           String[]                    @default([])
  rxNormId          String?                     @unique
  unii              String?                     @unique
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  products          ProductIngredient[]
  customerAllergies CustomerIngredientAllergy[]

  @@index([canonicalName])
}

model ProductIngredient {
  productId      String
  ingredientId   String
  strength       String?
  sourceName     String
  sourceRecordId String?
  sourceUrl      String
  verifiedAt     DateTime   @default(now())
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@index([ingredientId])
}

model ProductImageAsset {
  id             String   @id @default(cuid())
  productId      String   @unique
  storageKey     String   @unique
  mimeType       String
  width          Int
  height         Int
  byteSize       Int
  sha256         String
  sourceImageUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sha256])
}

model ProductParentPack {
  id                String                @id @default(cuid())
  productId         String
  packUnit          String
  childPackUnit     String
  childPackQuantity Decimal               @db.Decimal(14, 3)
  label             String
  priceMultiplier   Decimal               @db.Decimal(14, 3)
  sellPriceThb      Decimal?              @db.Decimal(14, 2)
  barcode           String?               @unique
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodeAliases    ProductBarcodeAlias[]

  @@unique([productId, packUnit, childPackQuantity])
  @@index([productId])
}

model ProductBarcodeAlias {
  barcode      String             @id
  productId    String
  parentPackId String?
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  parentPack   ProductParentPack? @relation(fields: [parentPackId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([parentPackId])
}

model ProductBatch {
  id             String   @id @default(cuid())
  productId      String
  batchNo        String?
  expiryDate     String
  sellPriceThb   Decimal  @db.Decimal(14, 2)
  availableStock Decimal  @db.Decimal(14, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, batchNo, expiryDate])
  @@index([productId])
  @@index([productId, expiryDate])
  @@index([expiryDate])
}

model Distributor {
  id            String         @id @default(cuid())
  code          String?        @unique
  name          String         @unique
  phone         String?
  email         String?
  purchaseBills PurchaseBill[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Customer {
  id                  String                      @id
  memberCode          String?                     @unique
  name                String
  mobile              String?
  address             String?
  avatarUrl           String?
  isMember            Boolean                     @default(false)
  points              Int                         @default(0)
  membershipRank      String?
  favoriteProducts    CustomerFavoriteProduct[]
  sales               Sale[]
  importedPurchaseHistory CustomerPurchaseHistoryImport[]
  ingredientAllergies CustomerIngredientAllergy[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([mobile])
}

model CustomerIngredientAllergy {
  customerId   String
  ingredientId String
  createdAt    DateTime   @default(now())
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([customerId, ingredientId])
  @@index([ingredientId])
}

model CustomerFavoriteProduct {
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@index([productId])
}

model CustomerPurchaseHistoryImport {
  id                  String   @id
  customerId          String
  productId           String
  customerCode        String
  externalProductCode String
  sourceItemName      String
  unit                String
  quantity            Decimal  @db.Decimal(14, 3)
  totalAmount         Decimal  @db.Decimal(14, 2)
  reportStartedAt     DateTime?
  reportEndedAt       DateTime?
  sourceFileName      String
  sourceFileHash      String
  sourceRow           Int
  customerRow         Int
  importedBy          String
  createdAt           DateTime @default(now())
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([sourceFileHash, sourceRow])
  @@index([customerId, reportEndedAt])
  @@index([productId])
}

model Owner {
  id        String   @id
  name      String
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pharmacist {
  id        String   @id
  name      String
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StorePosSettings {
  id                  String   @id
  showProductLocation Boolean  @default(false)
  paymentMethods      Json
  updatedBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model StoreProfile {
  id                String   @id
  storeName         String
  phone             String   @default("")
  email             String   @default("")
  taxId             String   @default("")
  pharmacyLicense   String   @default("")
  address           String   @default("")
  lineId            String   @default("")
  facebookPage      String   @default("")
  openingTime       String   @default("")
  closingTime       String   @default("")
  imageData         Bytes?
  imageMimeType     String?
  imageUpdatedAt    DateTime?
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PurchaseBill {
  id                 String                      @id
  billNo             String                      @unique
  invoiceNo          String
  purchasedAt        DateTime
  distributorId      String?
  distributorName    String
  itemCount          Int
  totalQty           Decimal                     @db.Decimal(14, 3)
  netTotal           Decimal                     @db.Decimal(14, 2)
  status             PurchaseBillStatus
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  distributor        Distributor?                @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  lines              PurchaseLine[]
  correctionRequests PurchaseCorrectionRequest[]
  stockAdjustments   StockAdjustment[]

  @@index([purchasedAt])
  @@index([purchasedAt, createdAt])
  @@index([distributorId])
}

model PurchaseCorrectionRequest {
  id              String                   @id
  purchaseBillId  String
  reason          String
  status          PurchaseCorrectionStatus @default(PENDING)
  requestedBy     String
  requestedRole   String
  requestedAt     DateTime                 @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  purchaseBill    PurchaseBill             @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  stockAdjustment StockAdjustment?

  @@index([purchaseBillId])
  @@index([status, requestedAt])
}

model StockAdjustment {
  id                  String                     @id
  purchaseBillId      String?
  correctionRequestId String?                    @unique
  reason              String
  adjustedBy          String
  createdAt           DateTime                   @default(now())
  purchaseBill        PurchaseBill?              @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)
  correctionRequest   PurchaseCorrectionRequest? @relation(fields: [correctionRequestId], references: [id], onDelete: SetNull)
  lines               StockAdjustmentLine[]

  @@index([purchaseBillId])
  @@index([createdAt])
}

model StockAdjustmentLine {
  id                String          @id
  stockAdjustmentId String
  productId         String
  batchNo           String?
  previousQuantity  Decimal         @db.Decimal(14, 3)
  newQuantity       Decimal         @db.Decimal(14, 3)
  delta             Decimal         @db.Decimal(14, 3)
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([stockAdjustmentId])
  @@index([productId, batchNo])
}

model PurchaseLine {
  id                 String       @id
  purchaseBillId     String
  productId          String
  barcode            String
  itemName           String
  unit               String
  unitMultiplier     Decimal      @db.Decimal(14, 3)
  quantity           Decimal      @db.Decimal(14, 3)
  cost               Decimal      @db.Decimal(14, 2)
  freeUnit           String
  freeUnitMultiplier Decimal      @db.Decimal(14, 3)
  freeQuantity       Decimal      @db.Decimal(14, 3)
  batchNo            String?
  expiryDate         String
  purchaseBill       PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  product            Product      @relation(fields: [productId], references: [id])

  @@index([purchaseBillId])
  @@index([productId])
  @@index([productId, batchNo])
}

model Sale {
  id             String        @id
  billNo         String        @unique
  soldAt         DateTime
  customerId     String?
  customerName   String
  isMember       Boolean       @default(false)
  itemCount      Int
  totalQuantity  Decimal       @db.Decimal(14, 3)
  paymentMethod  String
  purchaseMethod String
  subtotal       Decimal       @db.Decimal(14, 2)
  netTotal       Decimal       @db.Decimal(14, 2)
  customerPaid   Decimal?      @db.Decimal(14, 2)
  changeDue      Decimal?      @db.Decimal(14, 2)
  status         SaleStatus
  ownerId        String?
  pharmacistId   String?
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(14, 2)
  receiptSnapshot Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner          Owner?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  pharmacist     Pharmacist?   @relation(fields: [pharmacistId], references: [id], onDelete: SetNull)
  lines          SaleLine[]

  @@index([soldAt])
  @@index([customerId])
  @@index([status])
}

model SaleLine {
  id             String  @id
  saleId         String
  productId      String
  itemName       String
  packLabel      String
  packMultiplier Decimal @db.Decimal(14, 3)
  location       String
  batchNo        String
  expiryDate     String
  sellPriceThb   Decimal @db.Decimal(14, 2)
  unitPriceThb   Decimal? @db.Decimal(14, 2)
  quantity       Decimal @db.Decimal(14, 3)
  position       Int     @default(0)
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}
