{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.server.config.ts",
    "build:client": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors green,cyan \"vite --host 127.0.0.1 --port 3000\" \"tsx watch --clear-screen=false server/index.ts\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "node --env-file-if-exists=.env --import tsx --test server/*.test.ts src/server/auth/*.test.ts src/server/db/*.test.ts src/app/*.test.ts src/app/stock/*.test.ts src/app/settings/*.test.ts src/app/login/*.test.ts src/app/sales/new/*.test.ts src/features/events/components/navigation/*.test.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc --noEmit"
  },
