DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full"

# Temporary server-side role hook until the app has signed-in user sessions.
# Use staff, owner, or admin. Unset/invalid values safely default to staff.
PHARM_USER_ROLE="staff"
PHARM_USER_NAME="Pharmacy staff"


# Private Backblaze B2 product-image storage. Keep the application key server-only.
BACKBLAZE_B2_REGION=""
BACKBLAZE_B2_BUCKET=""
BACKBLAZE_B2_KEY_ID=""
BACKBLAZE_B2_APPLICATION_KEY=""

# Server-only QZ credentials; defaults to .local/qz-signing under the server cwd.
# PHARM_QZ_SIGNING_DIR="/private/path/to/qz-signing"
# Set to the browser-facing origin if a reverse proxy rewrites the Host header.
# PHARM_PUBLIC_ORIGIN="https://pharm.example.com"
